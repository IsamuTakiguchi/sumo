# AI 生成（ElevenLabs Music）を使うための設定。
# 内蔵シンセだけで使うなら、どれも設定不要です。
#
# 手元で試すときは、このファイルを .env.local にコピーして埋めてください。
# 本番（Railway）では Variables に同じ 3 つを登録します。

# ElevenLabs の API キー。https://elevenlabs.io → Settings → API Keys で発行。
# サーバー専用です。NEXT_PUBLIC_ を付けないでください（ブラウザに漏れます）。
ELEVENLABS_API_KEY=

# AI 生成を使うための合い言葉。自分で決めます。
# サイトは誰でも開けるので、これが無いと見知らぬ人があなたの API キーで曲を作れてしまいます。
APP_PASSPHRASE=

# AI 生成の選択肢を UI に出すかどうか。サーバーのある環境でだけ 1 にします。
# GitHub Pages のような静的配信では /api/music が存在しないので、設定しないでください。
NEXT_PUBLIC_AI_PROVIDER_ENABLED=

# ElevenLabs のエンドポイントを差し替えたいとき（テストやプロキシ経由）。
# 通常は空のままにします。
ELEVENLABS_API_URL=

# 公開先のオリジン。SNS のリンクプレビュー画像を絶対 URL にするために使います。
# 未設定でもアプリは動きますが、プレビュー画像が出ません。
#
# サブパス（NEXT_BASE_PATH）は Next 側が付けるので、ここには**入れないでください**。
# 入れると og:image が /sumo/sumo/... と二重になります。
# 例: https://sumo-production.up.railway.app
#     https://isamutakiguchi.github.io   ← /sumo は付けない
NEXT_PUBLIC_SITE_URL=
